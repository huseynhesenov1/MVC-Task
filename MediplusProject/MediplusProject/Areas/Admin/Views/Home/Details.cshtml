@using MediplusProject.Models;
@model SliderItem


<div class="main-panel">
    <div class="content-wrapper">
        <div class="row">

            <div class="col-lg-12 grid-margin stretch-card">
                <div class="card">
                    <div class="card-body">
                        <h4 class="card-title">Striped Table</h4>
                        <p class="card-description">
                            Add class <code>.table-striped</code>
                        </p>
                        <div class="table-responsive">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th>
                                            #
                                        </th>
                                        <th>
                                            Title
                                        </th>
                                        <th>
                                            Description
                                        </th>
                                        <th>
                                            IsDeleted
                                        </th>
                                            CreateDate
                                        <th>
                                        </th>
                                        <th>
                                            UpdateDate
                                        </th>
                                        <th>
                                            Image
                                        </th>
                                        <th>Update</th>
                                        <th>Hard Delete</th>
                                        <th>Restore</th>

                                       



                                    </tr>
                                </thead>
                                <tbody>



                                        <tr>
                                            <td class="py-1">
                                                @Model.Id
                                            </td>
                                            <td>
                                            @Model.Title
                                            </td>
                                              <td>
                                                  @Model.Description
                                             </td> 
                                            <td>
                                                 @Model.IsDeleted
                                            </td>
                                            <td>
                                                @Model.CreatedDate
                                            </td>
                                            <td>
                                                  @Model.UpdatedDate
                                            </td>

                                            <td>
                                            <img src="~/img/@Model.ImgPath" alt="image" />
                                            </td>
                                            <td><a class="btn btn-success">Update</a></td>
                                        <td><a asp-area="Admin" asp-controller="Home" asp-action="HardDelete" asp-route-id="@Model.Id" class="btn btn-danger">Hard Delete</a></td>
                                        <td><a asp-area="Admin" asp-controller="Home" asp-action="Restore" asp-route-id="@Model.Id" class="btn btn-info">Restore</a></td>
                                        </tr>
                                    

                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
    <!-- content-wrapper ends -->
    <!-- partial:../../partials/_footer.html -->
    <footer class="footer">
        <div class="d-sm-flex justify-content-center justify-content-sm-between">
            <span class="text-muted d-block text-center text-sm-left d-sm-inline-block">Huseyn Hesenov - 2024</span>
            <span class="float-none float-sm-right d-block mt-1 mt-sm-0 text-center"> Muelliflik huququ tam qorunur ! </span>
        </div>
    </footer>
    <!-- partial -->
</div>