@using LogisticaProject.Core.Entities
@model List<Transport>

<div class="main-panel">
    <div class="content-wrapper">
        <div class="row">

            <div class="col-lg-12 grid-margin stretch-card">
                <div class="card">
                    <div class="card-body">
                        <h4 class="card-title">Transport Table</h4>
                        <a asp-area="Admin" asp-controller="Home" asp-action="Create" class="btn btn-success">Create</a>
                        <div class="table-responsive">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th>
                                            #
                                        </th>
                                        <th>
                                           Title
                                        </th>
                                        <th>
                                            Description
                                        </th>
                                        <th>
                                            Imgpath
                                        </th>
                                        <th>
                                            TransportTypeId
                                        </th>
                                        <th>
                                            IsDeleted
                                        </th>

                                        <th>
                                            Update
                                        </th>
                                        <th>
                                            Soft Delete
                                        </th>
                                    </tr
                                    >
                                </thead>
                                <tbody>
                                    @foreach(var item in Model)
                                    {
                                        <tr>
                                            <td class="py-1">
                                                @item.Id
                                            </td>
                                            <td>
                                                @item.Title
                                            </td>
                                            <td>
                                                @item.Description
                                            </td>
                                            <td>
                                                @item.ImgPath
                                            </td>
                                            <td>
                                                @item.TransportTypeId
                                            </td>
                                            <td>
                                                @item.IsDeleted
                                            </td>
                                            <td>
                                                <a class="btn btn-info" asp-area="Admin" asp-controller="Home" asp-action="Update" asp-route-id="@item.Id" >Update</a>
                                            </td>
                                            <td>
                                                <a class="btn btn-danger" asp-area="Admin" asp-controller="Home" asp-action="SoftDelete" asp-route-id="@item.Id">Soft Delete</a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- content-wrapper ends -->
    <!-- partial:../../partials/_footer.html -->
    <footer class="footer">
        <div class="d-sm-flex justify-content-center justify-content-sm-between">
            <span class="text-muted d-block text-center text-sm-left d-sm-inline-block">Copyright © bootstrapdash.com 2020</span>
            <span class="float-none float-sm-right d-block mt-1 mt-sm-0 text-center"> Free <a href="https://www.bootstrapdash.com/" target="_blank">Bootstrap dashboard template</a> from Bootstrapdash.com</span>
        </div>
    </footer>
    <!-- partial -->
</div>