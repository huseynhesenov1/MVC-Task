@using LogisticaProject.BL.DTOs
@model TransportDto;

<div class="row ml-3">
    <h3 class="mb-3 mt-3">Create Order</h3>

    <div class="col-md-12">
        <form asp-action="Create" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>



            <div class="form-group">
                <label asp-for="Title" class="control-label"></label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Description" class="control-label"></label>
                <input asp-for="Description" class="form-control" />
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Image" class="control-label"></label>
                <input asp-for="Image" class="form-control" />
                <span asp-validation-for="Image" class="text-danger"></span>
            </div>

            <div class="form-group">

                <label asp-for="TransportTypeId" class="control-label"></label>
                <input asp-for="TransportTypeId" class="form-control" />
                <span asp-validation-for="TransportTypeId" class="text-danger"></span>
            </div>

            <div>
                <p class="text-danger"> @Html.ValidationSummary() </p>
            </div>

            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        </form>
    </div>
    <div>
        <a asp-action="Index">Back to List</a>
    </div>
</div>