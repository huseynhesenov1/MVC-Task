@model Transport;

<div class="row ml-3">
    <h3 class="mb-3 mt-3">Update Game</h3>

    <div class="col-md-12">
        <form asp-action="Update" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>



